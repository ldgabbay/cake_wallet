ARG BASE_IMAGE
FROM --platform=linux/amd64 ${BASE_IMAGE} AS build

ARG SUBMODULE_URL
ARG SUBMODULE_REF
COPY scripts/fetch_submodule.sh /w/scripts/fetch_submodule.sh
COPY scripts/functions.sh /w/scripts/functions.sh
COPY scripts/prepare_moneroc.sh /w/scripts/prepare_moneroc.sh
COPY scripts/android/build_monero_all.sh /w/scripts/android/build_monero_all.sh

# GNU configure refuses to run as root, and simplybs passes no environment
# through to bypass that, so the build runs as builder. It reads the
# toolchain in /root in place, since chowning /root would copy every file
# up through the overlay, and keeps its own caches in its home.
ARG UID=10001
ARG GID=10001
ARG USER=builder
RUN groupadd -g "$GID" "$USER" && \
    useradd  -m -u "$UID" -g "$GID" -s /bin/bash "$USER"
RUN chmod 755 /root && chown -R $UID:$GID /w
USER builder
ENV HOME=/home/builder GOPATH=/home/builder/go CARGO_HOME=/home/builder/.cargo RUSTUP_HOME=/root/.rustup

ARG COIN
ARG TARGET
ENV COIN=$COIN
ENV TARGET=$TARGET
RUN /w/scripts/android/build_monero_all.sh \
    && rm -rf /w/scripts/monero_c/contrib \
    /w/scripts/monero_c/.git \
    /w/scripts/monero_c/monero_libwallet2_api_c/build \
    /w/scripts/monero_c/wownero_libwallet2_api_c/build \
    /w/scripts/monero_c/zano_libwallet2_api_c/build

FROM --platform=linux/amd64 alpine
COPY --from=build /w /w
